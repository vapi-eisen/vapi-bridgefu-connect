set -euo pipefail
umask 077
# vapi-bridgefu-connect lab overlay install (adapted from the upstream qualification install script).
# Placeholders are rendered by scripts/lab/web_runtime.py. No secret values appear in this script.
region=__REGION__
source_prefix=__SOURCE_PREFIX__
expected_config_sha=__CONFIG_SHA__
expected_haproxy_sha=__HAPROXY_SHA__
auth_secret_arn=__SIP_AUTH_SECRET_ARN__
wss_port=__WSS_PORT__
run=/var/lib/bridgefu/lab
config=/etc/bridgefu/bridgefu.yaml
haproxy_cfg=/etc/haproxy/haproxy.cfg
dropin=/etc/systemd/system/bridgefu.service.d/lab-web-overlay.conf
wrapper=$run/bridgefu-lab-run
restore() {
  status=$?
  trap - EXIT
  if [ "$status" -ne 0 ]; then
    systemctl stop bridgefu.service >/dev/null 2>&1 || true
    if [ -f "$run/bridgefu.yaml.original" ]; then cp --preserve=all "$run/bridgefu.yaml.original" "$config" >/dev/null 2>&1 || true; fi
    if [ -f "$run/haproxy.cfg.original" ]; then cp --preserve=all "$run/haproxy.cfg.original" "$haproxy_cfg" >/dev/null 2>&1 || true; fi
    rm -f "$dropin"
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl reload haproxy.service >/dev/null 2>&1 || true
    systemctl start bridgefu.service >/dev/null 2>&1 || true
  fi
  exit "$status"
}
trap restore EXIT
[ "$(id -u)" -eq 0 ]
[ -f "$config" ] && [ ! -L "$config" ]
[ -f "$haproxy_cfg" ] && [ ! -L "$haproxy_cfg" ]
install -d -o root -g bridgefu -m 0750 "$run"
# Keep the very first originals if an earlier overlay is still applied; never overwrite them with an overlay.
if [ ! -f "$run/bridgefu.yaml.original" ]; then cp --preserve=all "$config" "$run/bridgefu.yaml.original"; fi
if [ ! -f "$run/haproxy.cfg.original" ]; then cp --preserve=all "$haproxy_cfg" "$run/haproxy.cfg.original"; fi
aws s3 cp "$source_prefix/bridgefu.json" "$run/bridgefu.yaml.candidate" --region "$region" --only-show-errors
aws s3 cp "$source_prefix/haproxy.cfg" "$run/haproxy.cfg.candidate" --region "$region" --only-show-errors
[ "$(sha256sum "$run/bridgefu.yaml.candidate" | awk '{print $1}')" = "$expected_config_sha" ]
[ "$(sha256sum "$run/haproxy.cfg.candidate" | awk '{print $1}')" = "$expected_haproxy_sha" ]
cat > "$wrapper" <<'BRIDGEFU_LAB_WRAPPER'
#!/usr/bin/env bash
set -euo pipefail
mode="${1:-run}"
config="${2:-/etc/bridgefu/bridgefu.yaml}"
if [[ "$mode" != run && "$mode" != validate ]]; then exit 64; fi
/usr/local/sbin/bridgefu-load-secrets
secret="$(aws secretsmanager get-secret-value --region "$BRIDGEFU_LAB_REGION" --secret-id "$BRIDGEFU_LAB_VAPI_SIP_AUTH_SECRET_ARN" --query SecretString --output text)"
python3 - /run/bridgefu/lab-vapi.env 3<<<"$secret" <<'PY'
import json, os, re, sys
path = sys.argv[1]
raw = os.read(3, 16385).decode("utf-8").rstrip("\n")
if len(raw.encode("utf-8")) > 16384:
    raise SystemExit(1)
value = json.loads(raw)
if set(value) != {"realm", "username", "password"} or value["realm"] != "sip.vapi.ai":
    raise SystemExit(1)
if not re.fullmatch(r"[A-Za-z0-9_-]{1,128}", value["username"]):
    raise SystemExit(1)
if not isinstance(value["password"], str) or not 16 <= len(value["password"]) <= 256 or any(c.isspace() for c in value["password"]):
    raise SystemExit(1)
temporary = path + ".new"
with open(temporary, "x", encoding="utf-8") as output:
    output.write("BRIDGEFU_LAB_VAPI_SIP_PASSWORD=" + value["password"] + "\n")
os.chmod(temporary, 0o600)
os.replace(temporary, path)
PY
unset secret
set -a
source /run/bridgefu/runtime.env
source /run/bridgefu/lab-vapi.env
set +a
exec /usr/local/bin/bridgefu --config "$config" "$mode"
BRIDGEFU_LAB_WRAPPER
chown root:bridgefu "$wrapper"
chmod 0750 "$wrapper"
BRIDGEFU_LAB_REGION="$region" BRIDGEFU_LAB_VAPI_SIP_AUTH_SECRET_ARN="$auth_secret_arn" "$wrapper" validate "$run/bridgefu.yaml.candidate" >/dev/null
haproxy -c -f "$run/haproxy.cfg.candidate" >/dev/null
systemctl stop bridgefu.service
install -o root -g bridgefu -m 0640 "$run/bridgefu.yaml.candidate" "$config"
install -o root -g root -m 0640 "$run/haproxy.cfg.candidate" "$haproxy_cfg"
install -d -o root -g root -m 0755 "$(dirname "$dropin")"
cat > "$dropin" <<EOF_DROPIN
[Service]
Environment=BRIDGEFU_LAB_REGION=$region
Environment=BRIDGEFU_LAB_VAPI_SIP_AUTH_SECRET_ARN=$auth_secret_arn
ExecStart=
ExecStart=$wrapper run /etc/bridgefu/bridgefu.yaml
EOF_DROPIN
chmod 0644 "$dropin"
systemctl daemon-reload
systemctl reload haproxy.service
systemctl start bridgefu.service
bridgefu_ready() {
  curl --silent --show-error --max-time 2 http://127.0.0.1:9090/readyz 2>/dev/null |
    python3 -c 'import json,sys; value=json.load(sys.stdin); raise SystemExit(0 if value.get("ok") is True and value.get("dependencies", {}).get("call_runtime") == "healthy" else 1)' >/dev/null 2>&1
}
bridgefu_lease_lost() {
  curl --silent --show-error --max-time 2 http://127.0.0.1:9090/readyz 2>/dev/null |
    python3 -c 'import json,sys; value=json.load(sys.stdin); raise SystemExit(0 if value.get("ok") is False and value.get("dependencies", {}).get("call_runtime") == "lease_lost" else 1)' >/dev/null 2>&1
}
wait_bridgefu_ready() {
  attempts="$1"
  for _ in $(seq 1 "$attempts"); do
    if systemctl is-active --quiet bridgefu.service && bridgefu_ready; then return 0; fi
    sleep 1
  done
  return 1
}
prove_bridgefu_renewal_stable() {
  for _ in $(seq 1 3); do
    sleep 5
    systemctl is-active --quiet bridgefu.service && bridgefu_ready || return 1
  done
}
if ! wait_bridgefu_ready 90 || ! prove_bridgefu_renewal_stable; then
  # A worker lease loss is terminal for one process; recover exactly that state once.
  systemctl is-active --quiet bridgefu.service
  bridgefu_lease_lost
  systemctl restart bridgefu.service
  wait_bridgefu_ready 90
  prove_bridgefu_renewal_stable
fi
ss -ltnH | awk '{print $4}' | grep -Eq "^(0\.0\.0\.0|\*):$wss_port$"
trap - EXIT
printf '%s\n' "{\"schema_version\":1,\"producer\":\"vapi-bridgefu-connect-lab-overlay@1\",\"action\":\"apply\",\"configuration_installed\":true,\"haproxy_installed\":true,\"bridgefu_ready\":true,\"wss_listener_ready\":true,\"wss_port\":$wss_port,\"config_sha256\":\"$expected_config_sha\"}"
